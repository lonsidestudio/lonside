# URL publique du site (pour sitemap, OG et robots)
NEXT_PUBLIC_SITE_URL=https://www.lonside.com

# Prise de rendez-vous en ligne (Cal.com / Calendly)
NEXT_PUBLIC_CALENDAR_URL=https://cal.com/lonside/cadrage

# Configuration des réseaux sociaux et contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@lonside.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/lonsidestudio
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/lonsidestudio
NEXT_PUBLIC_TWITTER_URL=https://x.com/lonsidestudio

# Resend — envoi des emails du formulaire de contact
# Obtenir une clé sur https://resend.com (plan gratuit : 100 emails/jour)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# PostHog Analytics — Télémétrie Privacy-First
# Obtenir votre clé sur https://eu.posthog.com (Project Settings -> Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Hôte par défaut : https://eu.i.posthog.com (Optionnel, valeur par défaut automatique)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Activer PostHog en local/développement pour tester (Optionnel, défaut false)
NEXT_PUBLIC_POSTHOG_DEBUG=false
